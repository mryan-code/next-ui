{
	"git.defaultBranchName": "master",
	"js/ts.validate.enable": true,
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"editor.formatOnSave": true,
	"eslint.enable": true,
	"prettier.configPath": ".prettierrc",
	"prettier.ignorePath": ".prettierignore",
	"errorLens.codeLensEnabled": true,
	"errorLens.editorHoverPartsEnabled": {
		"messageEnabled": true,
		"sourceCodeEnabled": true,
		"buttonsEnabled": true
	},
	"errorLens.gutterIconsEnabled": true,
	"files.watcherExclude": {
		"**/node_modules/**": true,
		"**/dist/**": true,
		"**/build/**": true,
		"**/.output/**": true,
		"**/coverage/**": true
	},
	"css.lint.emptyRules": "ignore",
	"scss.lint.emptyRules": "ignore",
	"less.lint.emptyRules": "ignore",
	"markdownlint.ignore": ["prompts.md", "ai_plans/*.md"],
	"markdownlint.config": {
		"MD025": false,
		"MD024": false,
		"MD041": false,
		"MD010": false,
		"MD013": false,
		"MD033": false,
		"MD022": false,
		"MD029": false,
		"MD030": false,
		"MD031": false,
		"MD032": false,
		"MD007": false,
		"MD034": false
	},
	"[vue]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	}
}
